<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.github.autodiag2.elm327emu.sim.serial.CustomView
        android:id="@+id/custom_serial_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/custom_serial_replay_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:padding="4dp"
        android:background="@drawable/custom_serial_replay_toolbar_background"
        android:elevation="6dp">

        <LinearLayout
            android:id="@+id/custom_serial_replay_toolbar_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/custom_serial_replay_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_serial_toolbar_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/custom_serial_replay_speed_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_serial_replay_speed" />

                <SeekBar
                    android:id="@+id/custom_serial_replay_speed"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50" />

                <TextView
                    android:id="@+id/custom_serial_replay_speed_value"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="x1" />

            </LinearLayout>

            <Button
                android:id="@+id/custom_serial_replay_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_serial_replay_start" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/custom_serial_replay_toolbar_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:minWidth="32dp"
        android:minHeight="24dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/custom_serial_replay_arrow_background"
        android:elevation="7dp"
        android:text="@string/custom_serial_toolbar_arrow_down"
        android:textSize="25sp" />

</FrameLayout>