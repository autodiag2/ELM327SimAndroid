<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sim_ecu_script_title"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- SCRIPT EDITOR -->
    <ScrollView
        android:id="@+id/editor_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/lua_editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:textSize="14sp"
            android:padding="16dp"
            android:textColor="?attr/android:textColor"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:imeOptions="flagNoExtractUi"
            android:text="
function response(req)\n
    -- Mode 01 supported PID\n
    if req[1] == 0x01 and req[2] == 0x00 then\n
        return {0x41, 0x00, 0xFF, 0xFF, 0xFF, 0xFF} -- all PIDs supported\n
    end\n
    -- Mode 01 PID 0C (engine RPM)\n
    if req[1] == 0x01 and req[2] == 0x0C then\n
        local rpm = 3000\n
        local value = rpm * 4\n
        return {\n
            0x41, 0x0C,\n
            math.floor(value / 256),\n
            value % 256\n
        }\n
    end\n
\n
    return {0x7F, req[1] or 0x00, 0x11}\n
    -- negative response\n
end\n
            " />

    </ScrollView>

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/background_with_border_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ROW 1: ACTION BUTTONS (SCROLLABLE) -->
        <HorizontalScrollView
            android:id="@+id/bottom_bar_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/bottom_bar_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copy_script"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sim_ecu_script_copy" />

                <Button
                    android:id="@+id/paste_script"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/sim_ecu_script_paste" />

                <Button
                    android:id="@+id/apply_script"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/sim_ecu_script_apply" />

                <Button
                    android:id="@+id/clear_script"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/sim_ecu_script_clear" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- ROW 2: ERROR OUTPUT -->
        <TextView
            android:id="@+id/error_return"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="?attr/android:textColor"
            android:textSize="12sp"
            android:paddingTop="8dp"
            android:maxLines="3" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>